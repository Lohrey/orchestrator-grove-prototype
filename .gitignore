# Dependencies
node_modules/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Logs / runtime
*.log
.DS_Store
.env
.env.*
!.env.example

# Generated smoke / verification artifacts (regenerable build output at repo root)
/*.png
/*.webm
/*.mp4
.kanban-*.html
wasm/**/target/

# Source sprite/art assets ARE tracked — negation overrides any broader image rule above.
# Keep assets/, ui-overlays/, public/ sprites committed so a fresh clone + sync is complete.
!assets/**
!ui-overlays/**/*.png
!public/**/*.png

# Local editor files
.vscode/
.idea/

# Local refactor scratch
*.bak
*.refactored
*.tmp
